**/.claude/cache/
*.exe
*.exe~
*.log
bin/
# playwright-cli scratch (browser snapshots/screenshots from UI verification)
**/.playwright-cli/

# Local stack
.env
/workspace/
# Local-only scratch (one-shot dispatches/probes; may reference operator data)
.spec/scratch/
# Build/test scratch (binaries, fixtures, probe output)
scratch/
# Local compose tweaks (Compose auto-merges this). Drop the coder override
# here to keep the coder on for your own host without the -f flag, while the
# committed default stays socket-free.
docker-compose.override.yaml
docker-compose.override.yml
# hinge-review scratch (per-review working files; not durable content)
scripts/hinge-review/hinge/*-body.txt
